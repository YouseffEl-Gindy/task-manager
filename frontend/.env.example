# Copy this file to .env.local for local development (.env.local is git-ignored).
#
# BACKEND_URL: where Next.js proxies /api/* requests (next.config.ts rewrites).
# Server/build-time only: do NOT prefix it with NEXT_PUBLIC_. The browser never
# calls this URL directly; it only calls relative /api/v1/... on this origin.
# No trailing slash. Read when `next dev` / `next build` starts.
#   Local:  http://localhost:5000
#   Vercel: https://<app>.azurewebsites.net  (set for Production and Preview, then redeploy)
BACKEND_URL=http://localhost:5000
