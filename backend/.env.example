# Backend environment variables (SPEC 5.5). Placeholders only - never commit real values.
# Local development needs none of these: appsettings.Development.json already sets
# Database__Provider=Sqlite, ConnectionStrings__Default=Data Source=taskmanager.db and Database__Schema=EnsureCreated.

ASPNETCORE_ENVIRONMENT=Production

# Sqlite (local dev / tests) or SqlServer (production). No default: startup fails if missing or unknown.
Database__Provider=SqlServer
# Migrate (SqlServer only) | EnsureCreated (Sqlite only) | None (default)
Database__Schema=Migrate

# SECRET. In Azure set it as an App Service connection string named "Default" (type SQLAzure).
ConnectionStrings__Default=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<db>;User ID=<app-user>;Password=<secret>;Encrypt=True;Connect Timeout=60;

Auth__SessionHours=8
# Always in every deployed environment; SameAsRequest for local HTTP only.
Auth__CookieSecure=Always
Auth__SecurityStampValidationSeconds=60

RateLimiting__AuthPermitLimit=10
RateLimiting__AuthWindowSeconds=60
# true when requests arrive through the Next.js / Vercel proxy.
RateLimiting__UseForwardedFor=true
