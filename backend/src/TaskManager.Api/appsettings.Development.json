{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=taskmanager.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "Schema": "EnsureCreated"
  },
  "Auth": {
    "CookieSecure": "SameAsRequest"
  },
  "RateLimiting": {
    "UseForwardedFor": true
  },
  "OpenApi": {
    "Enabled": true
  }
}
