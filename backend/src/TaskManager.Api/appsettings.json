{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Schema": "None"
  },
  "Auth": {
    "SessionHours": 8,
    "CookieSecure": "Always",
    "SecurityStampValidationSeconds": 60
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "UseForwardedFor": false
  }
}
